// 言語設計.md §2.2 の例
type User {
    name string
    age int
}

users: []User = [
    { name: "ようかん", age: 7 },
    { name: "たろう", age: 20 },
    { name: "はなこ", age: 18 },
]

adults = []
for user in users {
    if user.age >= 18 {
        adults += user
    }
}

for user at i in adults {
    print("{i}: {user.name}")
}
